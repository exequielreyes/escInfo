# Copiá este archivo a .env.local y completá los valores.

# Se generan automáticamente al conectar la base de datos (Vercel Postgres).
# En local, Vercel CLI puede traerlas por vos con `vercel env pull .env.local`.
POSTGRES_URL=""
POSTGRES_URL_NON_POOLING=""
POSTGRES_PRISMA_URL=""

# Usuario del panel de administración (ver README, sección "Panel de administración").
ADMIN_EMAIL="admin@escuelainformatica.edu.ar"
ADMIN_PASSWORD_HASH=""

# Clave secreta para firmar la sesión del panel. Cualquier texto largo y aleatorio sirve.
SESSION_SECRET=""
